[Desktop Entry]
Type=Application
Name=D-cut
GenericName=Video Editor
GenericName[pt_BR]=Editor de vídeo
Comment=Local-first open-source video editor
Comment[pt_BR]=Editor de vídeo local e de código aberto
Exec=d-cut %F
Icon=d-cut
